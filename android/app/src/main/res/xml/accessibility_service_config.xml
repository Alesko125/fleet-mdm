<?xml version="1.0" encoding="utf-8"?>
<!--
    Служба віддаленого керування.

    Вмикається виключно користувачем у системних налаштуваннях доступності.
    Використовується лише для жестів під час активного сеансу підтримки:
    вміст екрана службою не читається (canRetrieveWindowContent=false).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/support_input_description"
    android:notificationTimeout="100" />
