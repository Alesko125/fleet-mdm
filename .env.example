# =========================================================================
#  Fleet MDM — приклад конфігурації. Скопіюйте у .env і замініть ВСІ секрети.
#    cp .env.example .env
#    make secrets            # згенерує готові рядки для вставки
# =========================================================================

# --- загальні ------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_NAME=Fleet MDM
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console
# Публічний базовий URL, який агент отримує під час enrollment.
# У production обовʼязково https:// — сервер із http:// не стартує.
PUBLIC_BASE_URL=http://localhost:8000
# Домени, з якими застосунок погоджується працювати (захист від підміни Host).
# У production обовʼязковий; порожньо = приймати будь-який Host.
ALLOWED_HOSTS=

# --- база даних ----------------------------------------------------------
# Власник схеми: під ним виконуються ЛИШЕ міграції.
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me-postgres
# Роль застосунку: CRUD без права змінювати схему (створюється init-скриптом).
POSTGRES_APP_USER=fleet_app
POSTGRES_APP_PASSWORD=change-me-postgres-app
POSTGRES_DB=fleet
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Повний DSN (перекриває POSTGRES_* якщо задано)
# DATABASE_URL=postgresql+asyncpg://fleet_app:pass@postgres:5432/fleet

# --- redis ---------------------------------------------------------------
# Пароль обовʼязковий: у Redis лежать nonce автентифікації пристроїв і канали
# доставки команд — доступ до них рівносильний керуванню всім парком.
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0

# --- криптографія / JWT --------------------------------------------------
# ОБОВ'ЯЗКОВО згенеруйте власні значення. У production сервер не стартує
# з дефолтними/короткими ключами, а також якщо два секрети однакові.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ISSUER=fleet-mdm
JWT_AUDIENCE=fleet-api
ACCESS_TOKEN_TTL_SECONDS=900              # 15 хв
REFRESH_TOKEN_TTL_SECONDS=1209600         # 14 днів
DEVICE_TOKEN_TTL_SECONDS=3600             # 1 год, токен агента
ENROLLMENT_TOKEN_TTL_SECONDS=86400        # 24 год за замовчуванням
# Секрет для HMAC-хешування токенів у БД (enrollment/refresh зберігаються лише як хеш)
TOKEN_HASH_SECRET=change-me-token-hash-secret-at-least-32-chars

# --- ротація секретів ----------------------------------------------------
# Порядок ротації без розриву сесій:
#   1) JWT_SECRET_PREVIOUS=<старий>, JWT_SECRET=<новий>, перезапуск;
#   2) зачекати повний REFRESH_TOKEN_TTL_SECONDS;
#   3) прибрати JWT_SECRET_PREVIOUS.
# Те саме для TOKEN_HASH_SECRET (орієнтир — найдовший із refresh/enrollment TTL).
# Поточний стан: GET /api/v1/maintenance/secrets
JWT_SECRET_PREVIOUS=
TOKEN_HASH_SECRET_PREVIOUS=
# Аварійне відкликання ВСІХ токенів: поставте поточний час в ISO-8601.
# Наприклад TOKEN_EPOCH=2026-08-13T10:00:00Z
TOKEN_EPOCH=

# --- ротація ключів пристроїв -------------------------------------------
# Через скільки днів агент має перевипустити ключ (0 = без планової ротації).
DEVICE_KEY_MAX_AGE_DAYS=180
DEVICE_KEY_ROTATION_DAILY_LIMIT=3
DEVICE_KEY_HISTORY_DAYS=90

# --- cookie та CSRF ------------------------------------------------------
# Refresh-токен живе лише у HttpOnly-cookie — JavaScript його не бачить.
REFRESH_COOKIE_NAME=fleet_refresh
CSRF_COOKIE_NAME=fleet_csrf
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_PATH=/api/v1/auth
COOKIE_SAMESITE=strict                    # strict | lax | none
# Порожньо = Secure вмикається автоматично поза development/test.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# --- перший адміністратор (створюється лише якщо таблиця users порожня) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_NAME=Головний адміністратор

# --- CORS / фронтенд -----------------------------------------------------
# У production — лише https:// і без '*'.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# IP довірених проксі: лише від них враховується X-Forwarded-For.
TRUSTED_PROXIES=

# --- захист від брутфорсу ------------------------------------------------
MAX_FAILED_LOGINS=10
ACCOUNT_LOCK_SECONDS=900
MIN_PASSWORD_LENGTH=12

# --- rate limiting -------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PASSWORD=5/minute
RATE_LIMIT_ENROLL=20/hour
RATE_LIMIT_DEVICE_AUTH=60/minute
RATE_LIMIT_KEY_ROTATION=5/hour
RATE_LIMIT_REFRESH=60/minute
RATE_LIMIT_MUTATION=120/minute
RATE_LIMIT_UPLOAD=30/hour
RATE_LIMIT_DEVICE_REPORT=120/minute
RATE_LIMIT_DEFAULT=300/minute

# --- сховище файлів/APK --------------------------------------------------
STORAGE_ROOT=/var/lib/fleet/storage
MAX_UPLOAD_MB=512
MAX_FILE_TRANSFER_MB=256
# Стеля для звичайних JSON-запитів (файли мають власні ліміти).
MAX_JSON_BODY_KB=512
# SHA-256 дозволених сертифікатів підпису APK через кому.
# Порожньо = приймати будь-який підписаний пакет.
APK_ALLOWED_SIGNERS=

# --- комунікаційний модуль (SMS / журнал дзвінків) -----------------------
# ОПЦІЙНИЙ модуль, ВИМКНЕНИЙ за замовчуванням для кожного пристрою.
# Без цього ключа модуль неможливо ввімкнути: чутливий вміст (тексти, номери)
# лягає в БД лише зашифрованим (AES-256-GCM). Ключ живе в оточенні, не в БД.
#   python -c "import secrets; print('COMMS_ENCRYPTION_KEY='+secrets.token_urlsafe(48))"
COMMS_ENCRYPTION_KEY=
# Стеля ретеншну (адміністратор може задати менше per-device, не більше).
COMMS_RETENTION_MAX_DAYS=90
COMMS_RETENTION_DEFAULT_DAYS=30
COMMS_HISTORY_DAYS=30

# --- тонке налаштування (усі мають робочі дефолти) -----------------------
# Змінюйте лише за потреби: значення нижче — те, що застосовується мовчки.
API_PREFIX=/api/v1
# Повний DSN БД; якщо заданий — перекриває POSTGRES_* повністю.
# DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false                             # true = SQL у лог (лише для налагодження)
# Час життя challenge для автентифікації агента.
DEVICE_CHALLENGE_TTL_SECONDS=120
# Передача файлів: розмір чанка й термін дії передачі.
FILE_TRANSFER_CHUNK_KB=1024
FILE_TRANSFER_TTL_SECONDS=86400
# Скільки записів приймати за один звіт комунікаційного модуля.
COMMS_MAX_BATCH=2000
# Cookie: домен і форс Secure. Порожньо = автовизначення (див. вище).
# COOKIE_DOMAIN=
# COOKIE_SECURE=

# --- телеметрія ----------------------------------------------------------
DEVICE_OFFLINE_AFTER_SECONDS=180          # немає heartbeat → offline
TELEMETRY_HISTORY_DAYS=30
LOCATION_HISTORY_DAYS=90
AUDIT_RETENTION_DAYS=365
